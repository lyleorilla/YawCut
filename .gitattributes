# Auto detect text files and perform LF normalization on check-in
* text=auto eol=lf

# Explicitly declare text files that must always use LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.clineignore text eol=lf
LICENSE text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.onnx binary
